<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+) backup rules. Android 11 and below use backup_rules.xml - keep the include lists
    identical. See backup_rules.xml for the full rationale.

    POLICY (Phase 8, Step 22): explicit allowlist for BOTH cloud backup and device-to-device transfer.
    Only the main accounting database file and the automation last-run prefs are ever backed up or
    transferred; everything else is excluded by omission (lint rejects excludes outside an included path; see BackupPolicyTest).
    Cloud backup is skipped on devices that cannot encrypt it client-side.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="ledgerprime_accounting.db" />
        <include domain="sharedpref" path="ledgerprime_automation_cycle_prefs.xml" />

        <exclude domain="database" path="ledgerprime_accounting.db-wal" />
        <exclude domain="database" path="ledgerprime_accounting.db-shm" />
        <exclude domain="database" path="ledgerprime_accounting.db-journal" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="ledgerprime_accounting.db" />
        <include domain="sharedpref" path="ledgerprime_automation_cycle_prefs.xml" />

        <exclude domain="database" path="ledgerprime_accounting.db-wal" />
        <exclude domain="database" path="ledgerprime_accounting.db-shm" />
        <exclude domain="database" path="ledgerprime_accounting.db-journal" />
    </device-transfer>
</data-extraction-rules>